{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "qmd": {
        "type": "local",
        "command": ["qmd", "mcp"]
      },
      "playwright": {
        "type": "local",
        "command": ["playwright-mcp", "--browser", "chromium"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["node", "scripts/chrome-devtools-mcp.mjs"]
      }
    }
  }
}
