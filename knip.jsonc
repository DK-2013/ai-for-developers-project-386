{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Invoked from hk.pkl, not from a package script.
      "ignoreDependencies": ["agnix", "syncpack"],
    },
    "packages/spec": {
      // TypeSpec emitters are declared in tspconfig.yaml, not imported from TypeScript.
      "ignoreDependencies": [
        "@typespec/http",
        "@typespec/http-client-js",
        "@typespec/http-server-js",
        "@typespec/openapi3",
      ],
    },
    "packages/web": {
      // Imported by the generated @calendar/sdk sources, which are pulled in
      // through the `@calendar/sdk` alias rather than as a workspace package.
      "ignoreDependencies": ["@typespec/ts-http-runtime", "uri-template"],
    },
  },
}
