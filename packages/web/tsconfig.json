{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@calendar/sdk": ["./src/sdk/src/index.ts"],
      "@calendar/sdk/*": ["./src/sdk/src/*"]
    }
  },
  "include": ["src", "e2e", "playwright.config.ts", "vite.config.ts", "vitest.config.ts"]
}
