{
  "name": "@calendar/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:clean": "tsx src/db/clean-cli.ts",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "temporal-polyfill": "1.0.8"
  },
  "devDependencies": {
    "@types/node": "26",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
