# Local overrides. Copy this file to `.env`; it is optional and gitignored.
#
# Precedence: process environment > `.env` > defaults in
# `packages/server/src/config.ts`. The server validates every value at startup.
#
# `docker compose` reads `.env` too: app settings are passed into the container.
# `DATABASE_URL` and `PORT` are fixed for the container, so `PORT` here affects
# local development only.

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/call_calendar
# Apply Drizzle migrations when the server starts. Accepts true/false/1/0.
MIGRATE_ON_START=true

# API
PORT=3000
# Built web assets served by the API in production. Leave unset in development:
# Vite serves the web app and proxies `/api` to the server.
# WEB_DIST=packages/web/dist

# Owner's calendar
OWNER_TIMEZONE=Europe/Moscow
WORKING_HOURS_START=10:00
WORKING_HOURS_END=18:00
# ISO weekdays, 1 = Monday
WORKING_DAYS=1,2,3,4,5
