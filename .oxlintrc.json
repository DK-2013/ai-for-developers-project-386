{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "oxc",
    "typescript",
    "import",
    "react",
    "jsx-a11y",
    "node",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/spec/openapi.json",
    "packages/server/src/generated/**",
    "packages/web/src/sdk/**"
  ],
  "overrides": [
    {
      "files": ["packages/web/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      },
      "rules": {
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
      }
    },
    {
      // review 2027-06-30: React 19 uses the automatic JSX runtime, so React need not be in scope.
      "files": ["packages/web/**/*.tsx"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": ["packages/server/**/*.ts", "*.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      // review 2027-01-31: remove the override once packages/server/drizzle.config.ts exports its config.
      "files": ["packages/server/drizzle.config.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
