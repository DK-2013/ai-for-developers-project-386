{
  "name": "call-calendar",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm codegen && pnpm --filter @calendar/server build && pnpm --filter @calendar/web build",
    "codegen": "pnpm --filter @calendar/spec codegen",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @calendar/server db:generate",
    "db:up": "docker compose up -d db",
    "deps:check": "depcruise packages --config dependency-cruiser.cjs",
    "dev": "pnpm --parallel --filter @calendar/server --filter @calendar/web dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "agnix": "0.60.1",
    "dependency-cruiser": "18.7.0",
    "knip": "6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "syncpack": "15.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": "0.25.12",
      "undici@<7.30.1": "7.30.1"
    }
  }
}
